{
  "contractVersion": 2,
  "id": "sea-cave",
  "title": "Sea Cave",
  "description": "An original texture-free shoreline study: a dark cave frames two offshore sea stacks, moving surf, foam, wet sand and clouds. Approximate 2.5D depth, not a photographic or geographic reconstruction.",
  "source": "main.glsl",
  "initialTime": 24,
  "posterTime": 24,
  "pointer": true,
  "performance": { "fps": 30, "maxPixels": 1500000, "minPixels": 650000, "maxDpr": 1.5 },
  "tags": ["Procedural shoreline", "2.5D study", "Slow surf"],
  "attribution": "Original procedural reconstruction guided by a supplied photograph. The photograph is not redistributed or sampled as a texture; its location and license are unverified. Other light and weather settings are fictional.",
  "transitionSeconds": 2.5,
  "controls": {
    "weather": { "type": "enum", "label": "Weather", "options": ["clear", "cloudy", "fog"], "default": "clear" },
    "seaState": { "type": "enum", "label": "Sea state", "options": ["calm", "rolling", "rough"], "default": "rolling" },
    "timeOfDay": { "type": "number", "label": "Scene time", "min": 0, "max": 24, "step": 0.25, "default": 9 }
  },
  "presets": [
    { "id": "morning", "label": "Morning", "values": { "weather": "clear", "seaState": "rolling", "timeOfDay": 9 } },
    { "id": "calm-afternoon", "label": "Calm afternoon", "values": { "weather": "clear", "seaState": "calm", "timeOfDay": 14 } },
    { "id": "golden-hour", "label": "Golden hour", "values": { "weather": "clear", "seaState": "rolling", "timeOfDay": 17.5 } },
    { "id": "overcast", "label": "Overcast surf", "values": { "weather": "cloudy", "seaState": "rough", "timeOfDay": 14 } },
    { "id": "misty-dawn", "label": "Misty dawn", "values": { "weather": "fog", "seaState": "calm", "timeOfDay": 7 } },
    { "id": "night", "label": "Night", "values": { "weather": "clear", "seaState": "rolling", "timeOfDay": 22 } }
  ],
  "parameters": {
    "uSunHour": { "type": "float", "min": 0, "max": 24, "wrap": true, "default": 9 },
    "uCloudCoverage": { "type": "float", "min": 0, "max": 1, "default": 0.25 },
    "uFogDensity": { "type": "float", "min": 0, "max": 1, "default": 0.1 },
    "uWind": { "type": "float", "min": 0, "max": 2, "default": 0.7 },
    "uWaveStrength": { "type": "float", "min": 0, "max": 1, "default": 0.55 }
  }
}
